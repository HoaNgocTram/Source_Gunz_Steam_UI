<!--이미지는 BitmapAlias.xml에서 검색-->

<!-- 프레임 생성 : NewMatchServerList -->
	<FRAME item="IntroLogo">
		<FRAMELOOK>NullFrameLook</FRAMELOOK>
		<BOUNDS>
			<X>0</X>
			<Y>0</Y>
			<W>1920</W>
			<H>1080</H>
		</BOUNDS>
		<TITLEBAR>false</TITLEBAR>
		<RESIZABLE>false</RESIZABLE>
