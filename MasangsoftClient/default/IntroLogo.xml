			<Y>0</Y>
			<W>1920</W>
			<H>1080</H>
		</BOUNDS>
		<BITMAP type="Intro">Interface/default/Loading/Intro01.png</BITMAP>
	</ZINTROLOGO>

	<VIDEOCANVAS item="IntroVideo" parent="IntroLogo">
		<BOUNDS>
			<X>0</X>
			<Y>0</Y>
			<W>1920</W>
			<H>1080</H>
		</BOUNDS>
