<?xml version="1.0" encoding="UTF-8" ?>
<XML ID="WEBVIEW_CONTAINER">
    <FRAME item="WEBVIEW_CONTAINER">
        <FRAMELOOK>DefaultFrameLook</FRAMELOOK>
        <BOUNDS>
            <X>0</X>
            <Y>0</Y>
            <W>780</W>
            <H>580</H>
        </BOUNDS>
        <ALIGN>
            <HALIGN>center</HALIGN>
            <VALIGN>center</VALIGN>
        </ALIGN>
        <VISIBLE>false</VISIBLE>
        <TEXT>GunZ Web Browser</TEXT>
    </FRAME>

    <!-- Khung vùng hiển thị Web: nằm lùi vào trong Frame để không che Tiêu đề & Nút Close -->
    <PICTURE item="WebViewArea" parent="WEBVIEW_CONTAINER">
        <BOUNDS>
            <X>15</X>
            <Y>35</Y>
            <W>380</W>
            <H>333</H>
        </BOUNDS>
    </PICTURE>

    <!-- Nút Đóng đặt bên dưới khung Web -->
    <BUTTON item="CloseWebView" parent="WEBVIEW_CONTAINER">
        <BOUNDS>
            <X>355</X>
            <Y>540</Y>
            <W>70</W>
            <H>30</H>
        </BOUNDS>
        <TEXT>Close</TEXT>
        <DEFAULTKEY>ESC</DEFAULTKEY>
    </BUTTON>
</XML>