<?xml version="1.0" encoding="UTF-8"?>
<EMOJIS lobby_size="22" ingame_size="22">
	<!--
		Yahoo Messenger Emoticon Set
		pattern  = text pattern to match
		file     = GIF filename in Interface/default/emojis/yahoo/
		space    = "true" (default) requires space before pattern, "false" = no space needed
		w, h     = custom width/height in pixels (0 = use lobby_size or ingame_size)
		
		XML special characters:
		< = &lt;   > = &gt;   & = &amp;   " = &quot;   ' = &apos;
		\ = \\
	-->

	<!-- ============================================ -->
	<!-- Version 11 emoticons (longest patterns first) -->
	<!-- ============================================ -->
